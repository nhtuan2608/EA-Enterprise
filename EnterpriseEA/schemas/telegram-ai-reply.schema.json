{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnterpriseEA Telegram AI answer v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "chat_id", "reply_to_message_id", "response_status", "answer", "evidence_refs", "context_captured_at_utc", "created_at_utc", "valid_until_utc", "provider", "delivery_status"],
  "properties": {
    "schema_version": {"const": "telegram-ai-v1.0.0"},
    "request_id": {"type": "string", "minLength": 1},
    "chat_id": {"type": "string", "minLength": 1},
    "reply_to_message_id": {"type": "integer", "minimum": 1},
    "response_status": {"enum": ["OK", "TIMEOUT", "AI_OFFLINE", "MALFORMED", "CONTEXT_UNAVAILABLE"]},
    "answer": {"type": "string"},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "context_captured_at_utc": {"type": "integer", "minimum": 0},
    "created_at_utc": {"type": "integer", "minimum": 1},
    "valid_until_utc": {"type": "integer", "minimum": 1},
    "provider": {"type": "string", "minLength": 1},
    "delivery_status": {"enum": ["PENDING", "DELIVERED", "FAILED"]}
  }
}
