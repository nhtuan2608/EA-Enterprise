{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnterpriseEA Telegram AI question v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "telegram_update_id", "chat_id", "user_id", "role", "request_type", "question", "context_scope", "created_at_utc", "deadline_at_utc", "context_snapshot_ids", "account_id", "config_version"],
  "properties": {
    "schema_version": {"const": "telegram-ai-v1.0.0"},
    "request_id": {"type": "string", "minLength": 1},
    "telegram_update_id": {"type": "integer", "minimum": 1},
    "chat_id": {"type": "string", "minLength": 1},
    "user_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["VIEWER", "OPERATOR"]},
    "request_type": {"const": "ASK_AI"},
    "question": {"type": "string", "minLength": 1},
    "context_scope": {"type": "array", "items": {"enum": ["EA_STATUS", "RISK_SUMMARY", "MARKET_CONTEXT", "NEWS_CONTEXT", "AUDIT_SUMMARY"]}},
    "created_at_utc": {"type": "integer", "minimum": 1},
    "deadline_at_utc": {"type": "integer", "minimum": 1},
    "context_snapshot_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "account_id": {"type": "string", "minLength": 1},
    "config_version": {"type": "string", "minLength": 1}
  }
}
