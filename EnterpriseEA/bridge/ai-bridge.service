# systemd unit template for an Ubuntu VPS running MT5 under Wine.
# Edit User, the paths and the queue root, then:
#   sudo cp ai-bridge.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now ai-bridge
[Unit]
Description=EnterpriseEA AI bridge (Level 0/1, reports only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
WorkingDirectory=/opt/enterpriseea/bridge
ExecStart=/usr/bin/python3 /opt/enterpriseea/bridge/ai_bridge.py --loop \
  --queue-root "/home/trader/.wine/drive_c/users/trader/AppData/Roaming/MetaQuotes/Terminal/TERMINAL_ID/MQL5/Files/EnterpriseEA"
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
