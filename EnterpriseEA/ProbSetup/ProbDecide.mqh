#ifndef ENTERPRISE_EA_PROB_DECIDE_MQH
#define ENTERPRISE_EA_PROB_DECIDE_MQH

// G114 decision rule in MQL (mirrors research/long/g114_prob.py):
//   score  = base + sum of the weights of the factor levels in the frozen table (absent levels: 0); for the
//            naive-Bayes model base = logit(p0) and the weights are log LR, for the logistic model base = the
//            intercept and the weights are the one-hot coefficients (same additive form)
//   p, n   = isotonic step function (block whose lowest score <= score; below the first block -> the first block)
//   p_lo   = Wilson 90 % lower bound of p with n trades
//   EV_lo  = p_lo * W - (1 - p_lo) * L          (W / L = mean win / loss R of the training trades)
//   size   = 1/4 Kelly = 0.25 * EV_lo / var R, capped at 1 R (0 when EV_lo <= 0)
// The tables (ProbSetup/ProbTables.mqh) are generated by research/long/g114_export_mql.py.

#define PS_Z90 1.6448536269514722

struct PsLr    { int fam; int factor; int level; double w; };
struct PsBlock { int fam; double lo; double p; double n; };
struct PsFam   { int id; double base; double W; double L; double var_r; bool passed; };

double PsWilsonLower(const double p,const double n,const double z=PS_Z90)
  {
   if(n<=0.0) return 0.0;
   const double den=1.0+z*z/n;
   const double centre=p+z*z/(2.0*n);
   const double rad=z*MathSqrt(MathMax(p*(1.0-p)/n+z*z/(4.0*n*n),0.0));
   return MathMax(0.0,(centre-rad)/den);
  }

double PsEvLower(const double p_lo,const double W,const double L) { return p_lo*W-(1.0-p_lo)*L; }

double PsKelly(const double ev_lo,const double var_r,const double frac=0.25,const double cap=1.0)
  {
   if(ev_lo<=0.0 || var_r<=0.0) return 0.0;
   return MathMin(cap,frac*ev_lo/var_r);
  }

// additive score of one family: levels[k] is the level of factor k (factor ids 0..nf-1)
double PsScore(const PsFam &f,const PsLr &tab[],const int &levels[],const int nf)
  {
   double s=f.base;
   const int n=ArraySize(tab);
   for(int i=0;i<n;i++)
     {
      if(tab[i].fam!=f.id || tab[i].factor<0 || tab[i].factor>=nf) continue;
      if(levels[tab[i].factor]==tab[i].level) s+=tab[i].w;
     }
   return s;
  }

// isotonic step function: blocks of the family sorted by lo (generated sorted)
bool PsCalibrate(const int fam,const PsBlock &blocks[],const double score,double &p,double &n)
  {
   int first=-1, pick=-1;
   const int m=ArraySize(blocks);
   for(int i=0;i<m;i++)
     {
      if(blocks[i].fam!=fam) continue;
      if(first<0) first=i;
      if(blocks[i].lo<=score) pick=i;
     }
   if(first<0) return false;
   if(pick<0) pick=first;
   p=blocks[pick].p; n=blocks[pick].n;
   return true;
  }

struct PsDecision { bool ok; double score, p, n, p_lo, ev_lo, size; };

PsDecision PsDecide(const PsFam &f,const PsLr &tab[],const PsBlock &blocks[],const int &levels[],const int nf)
  {
   PsDecision d; d.ok=false; d.score=PsScore(f,tab,levels,nf); d.p=0; d.n=0; d.p_lo=0; d.ev_lo=-1e9; d.size=0;
   if(!PsCalibrate(f.id,blocks,d.score,d.p,d.n)) return d;
   d.p_lo=PsWilsonLower(d.p,d.n);
   d.ev_lo=PsEvLower(d.p_lo,f.W,f.L);
   d.size=PsKelly(d.ev_lo,f.var_r);
   d.ok=(d.ev_lo>0.0);
   return d;
  }

#endif
